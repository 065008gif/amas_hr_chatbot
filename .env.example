# Copy this file to .env and put your real values in .env (never in this file).
# .env is ignored by git. This file is committed and must only hold FAKE values.

# Ollama cloud API (https://ollama.com/api/chat). NOT the local college Ollama.
OLLAMA_API_KEY=changeme

# Google AI Studio (Gemini free tier), used as the fallback model.
GEMINI_API_KEY=changeme

# Comma-separated frontend addresses allowed to call the backend directly (CORS). Locally the portal calls /api
# through the Vite proxy, so the default is enough.
CORS_ORIGINS=http://localhost:5173

# OPTIONAL: Upstash Redis for persistent tickets, cache and logs (the Vercel integration sets these).
# Leave them out locally: the backend then uses SQLite in data/runtime/.
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=changeme
