# Copy this file to .env and put your real values in .env (never in this file).
# .env is ignored by git. This file is committed and must only hold FAKE values.

# Ollama cloud API (https://ollama.com/api/chat). NOT the local college Ollama.
OLLAMA_API_KEY=changeme

# Google AI Studio (Gemini free tier), used as the fallback model.
GEMINI_API_KEY=changeme

# Comma-separated frontend addresses allowed to call the backend (CORS). Set on the Space in Phase 8.
CORS_ORIGINS=http://localhost:5173
